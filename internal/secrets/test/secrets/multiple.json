    {
        "id": "db-creds",
        "version": 1,
        "create": "openssl rand -base64 32",
        "destroy": "rm -f /etc/enrypted-creds/$SECRET_ID/$INSTANCE_ID.cred",
        "activate": "cp -f /etc/enrypted-creds/$SECRET_ID/$INSTANCE_ID.cred /etc/enrypted-creds/service.cred",
        "deactivate": "rm -f /etc/enrypted-creds/service.cred",
        "test": "ssh host -csecret-agent test $SECRET_ID $INSTANCE_ID"
    }
]